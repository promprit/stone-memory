# Cloudflare Pages headers.
#
# Note the division of labour with public/_routes.json: that file decides
# which paths reach the Functions runtime at all (only /api/*),
# this one decides what every response carries.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Fingerprinted build output — safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts ship with the build and never change under a given name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Brand marks are replaced in place when the real kit lands, so they must not
# be cached for a year.
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

