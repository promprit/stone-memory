---
/**
 * /devlog — the index.
 *
 * Not mocked in the design canvas, and derived rather than invented: screen
 * 1c draws the entry row (fixed 110px mono date column, title, optional
 * MILESTONE badge, top hairlines) and its "ALL ENTRIES →" link is this page's
 * entry point. So the index is 1c's list at full length in the standard
 * sidebar shell. See design doc §6.2 — no new vocabulary.
 */
import Shell from '../../layouts/Shell.astro';
import DevlogRow from '../../components/DevlogRow.astro';
import { allEntries } from '../../lib/devlog';

const entries = await allEntries();
---

<Shell
  title="Devlog"
  description="Build notes from Dryas Studio, written by the person making the game."
  active="devlog"
>
  <section class="page">
    <p class="kicker">Devlog</p>
    <h1 class="display heading">All entries</h1>
    <p class="lede">
      Build notes, in the open, newest first. Written by the person making the game.
    </p>

    <div class="list">
      {
        entries.map((entry, i) => (
          <DevlogRow entry={entry} latest={i === 0} last={i === entries.length - 1} />
        ))
      }
    </div>
  </section>

</Shell>

<style>
  .page {
    padding: 72px 96px;
    max-width: 900px;
  }

  .heading {
    margin: 16px 0 0;
    font-size: 44px;
    line-height: 1.15;
    letter-spacing: 0.04em;
  }

  .lede {
    margin: 24px 0 0;
    font: 400 17px/1.75 var(--font-body);
    color: var(--moss-pale);
    max-width: 620px;
  }

  .list {
    margin-top: 40px;
  }

  @media (max-width: 900px) {
    .page {
      padding: 40px 24px;
    }
    .heading {
      font-size: 34px;
    }
  }
</style>
