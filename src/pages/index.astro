---
/**
 * Home — screen `1c`, layout kept.
 *
 * Sidebar: 64px mark, studio name, mono tagline, intro paragraph, route nav,
 * email signup pinned to the bottom.
 * Main: the studio band naming the service lines, then the footer.
 *
 * Placeholder copy (2026-09-13): GATEKEEP was dropped and the devlog
 * unpublished. The real parent-studio content — DRYAS as owner of Sidecraft
 * and BrewMind — lands in the planning phase.
 */
import Shell from '../layouts/Shell.astro';
import EmailSignup from '../components/EmailSignup.astro';
import StudioFooter from '../components/StudioFooter.astro';

const lines = [
  { name: 'Sidecraft', pitch: 'Websites that ship in weeks.' },
  { name: 'BrewMind', pitch: 'Proprietary product.' },
];
---

<Shell
  title="Dryas Studio"
  bareTitle
  description="Dryas Studio is a digital studio, home of Sidecraft and BrewMind."
  markSize={64}
>
  <Fragment slot="sidebar-top">
    <div>
      <div class="studio-name">Dryas Studio</div>
      <div class="tagline">STUDIO · DIGITAL · 2026</div>
    </div>
    <p class="intro">
      A digital studio building products and productized services.
    </p>
  </Fragment>

  <EmailSignup slot="sidebar-bottom" list="updates" label="Studio news by email" cta="→" />

  {/* ── Studio band ────────────────────────────────────────────────────── */}
  <section class="feature">
    <div class="feature-meta">
      <span class="badge">DRYAS STUDIO</span>
      <span class="status">STATUS: NEW SITE COMING</span>
    </div>

    <h1 class="game-title">DRYAS STUDIO</h1>
    <p class="pitch">The studio behind Sidecraft and BrewMind.</p>
  </section>

  <section class="lines" aria-label="Service lines and products">
    <h2 class="kicker">What we run</h2>
    <ul class="line-list">
      {
        lines.map(({ name, pitch }) => (
          <li class="line">
            <span class="line-name">{name}</span>
            <span class="line-pitch">{pitch}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <StudioFooter />
</Shell>

<style>
  /* ── Sidebar ──────────────────────────────────────────────────────────── */

  .studio-name {
    font: 500 30px/1.15 var(--font-display);
    letter-spacing: 0.06em;
    color: var(--paper);
    text-transform: uppercase;
  }

  .tagline {
    font: 400 12px var(--font-mono);
    letter-spacing: 0.32em;
    color: var(--slate-grey);
    margin-top: 8px;
  }

  .intro {
    font: 400 14px/1.7 var(--font-body);
    color: var(--moss-pale);
  }

  /* ── Studio band ──────────────────────────────────────────────────────── */

  .feature {
    padding: 48px 56px;
    border-bottom: 1px solid var(--hairline);
  }

  .feature-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .status {
    font: 400 11px var(--font-mono);
    letter-spacing: 0.14em;
    color: var(--slate-grey);
  }

  .game-title {
    font: 500 56px/1 var(--font-display);
    letter-spacing: 0.08em;
    color: var(--paper);
  }

  .pitch {
    margin: 18px 0 0;
    font: 400 15px/1.65 var(--font-body);
    color: var(--moss-pale);
    max-width: 480px;
  }

  /* ── Service lines ────────────────────────────────────────────────────── */

  .lines {
    padding: 40px 56px;
  }

  .lines .kicker {
    margin-bottom: 20px;
  }

  .line-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .line {
    display: flex;
    gap: 24px;
    padding: 16px 0;
    border-top: 1px solid var(--hairline);
  }
  .line:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .line-name {
    width: 140px;
    flex: none;
    font: 500 13px var(--font-mono);
    letter-spacing: 0.12em;
    color: var(--paper);
    text-transform: uppercase;
  }

  .line-pitch {
    font: 400 14px/1.6 var(--font-body);
    color: var(--moss-pale);
  }

  @media (max-width: 900px) {
    .feature,
    .lines {
      padding: 32px 24px;
    }
    .game-title {
      font-size: 44px;
    }
    .line {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
