---
/**
 * Route nav. Mono 13px, .12em, uppercase-by-content.
 *
 * The active route is Paper and prefixed `→`; the rest are Slate and brighten
 * to Moss Pale on hover.
 *
 * `/contact` is in every sidebar in the design and has no screen of its own —
 * the handoff puts contact inside /about, and screen 2c carries the full
 * contact block. So the item points at the anchor rather than a page that
 * would duplicate it. See design doc §6.2.
 *
 * `/gatekeep` is served by the other repo (promprit/one-lane) through the
 * proxy Function. Same-origin, so it is a plain href like any other.
 */
export type Route = 'gatekeep' | 'devlog' | 'about' | 'press' | 'contact';

interface Props {
  active?: Route;
}

const { active } = Astro.props;

const items: { key: Route; label: string; href: string }[] = [
  { key: 'gatekeep', label: '/gatekeep', href: '/gatekeep/' },
  { key: 'devlog', label: '/devlog', href: '/devlog' },
  { key: 'about', label: '/about', href: '/about' },
  { key: 'press', label: '/press', href: '/press' },
  { key: 'contact', label: '/contact', href: '/about#contact' },
];
---

<nav class="nav" aria-label="Studio">
  {
    items.map(({ key, label, href }) => {
      const isActive = key === active;
      return (
        <a
          href={href}
          class:list={['item', { active: isActive }]}
          aria-current={isActive ? 'page' : undefined}
        >
          {isActive ? `→ ${label}` : label}
        </a>
      );
    })
  }
</nav>

<style>
  .nav {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font: 500 13px var(--font-mono);
    letter-spacing: 0.12em;
  }

  .item {
    color: var(--slate-grey);
  }
  .item:hover {
    color: var(--moss-pale);
  }
  .item.active {
    color: var(--paper);
  }

  /* Below the breakpoint the sidebar is a top bar, so the nav wraps into a
     row. The handoff offers "hamburger or wrapped route nav" — wrapping
     keeps the whole site free of client JavaScript except the email form. */
  @media (max-width: 900px) {
    .nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 8px 20px;
    }
    .item {
      /* >=44px touch target without changing the type. */
      padding: 12px 0;
    }
  }
</style>
