---
/**
 * One row of the devlog list, from screen 1c: a fixed 110px mono date column,
 * the title, and an optional MILESTONE badge — separated by top hairlines.
 *
 * The newest entry's title is Paper; older ones are Moss Pale. That is the
 * only thing the `latest` flag changes.
 */
import type { DevlogEntry } from '../lib/devlog';
import { dateOf, hrefOf, numberOf } from '../lib/devlog';

interface Props {
  entry: DevlogEntry;
  latest?: boolean;
  /** The last row in a list gets a bottom hairline as well as a top one. */
  last?: boolean;
}

const { entry, latest = false, last = false } = Astro.props;
---

<div class:list={['row', { last }]}>
  <span class="date">{dateOf(entry)}</span>
  <a href={hrefOf(entry)} class:list={['title', { latest }]}>
    {numberOf(entry)} — {entry.data.title}
  </a>
  {entry.data.milestone && <span class="badge-soft">MILESTONE</span>}
</div>

<style>
  .row {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: 18px 0;
    border-top: 1px solid var(--hairline);
  }
  .row.last {
    border-bottom: 1px solid var(--hairline);
  }

  .date {
    flex: none;
    width: 110px;
    font: 400 12px var(--font-mono);
    color: var(--slate-grey);
  }

  .title {
    flex: 1;
    font: 500 17px var(--font-body);
    color: var(--moss-pale);
    text-wrap: pretty;
  }
  .title.latest {
    color: var(--paper);
  }
  .title:hover {
    color: var(--paper);
  }

  @media (max-width: 900px) {
    .row {
      flex-wrap: wrap;
      gap: 6px 16px;
    }
    .date {
      width: auto;
    }
    .title {
      flex: 1 0 100%;
      order: 3;
    }
  }
</style>
