---
/**
 * Top bar, matched to the landing page's: glowing mark + DRYAS on the left;
 * the landing page's two chapter links and the "Start a project" pill on the
 * right. The pill is the /contact/ route, so it carries aria-current there.
 * Sticky and solid rather than the landing page's scroll-triggered fade,
 * since these pages ship no JavaScript.
 */
export type Route = 'contact';

interface Props {
  active?: Route;
}

const { active } = Astro.props;
---

<header class="top">
  <a class="wordmark" href="/" aria-label="Dryas Studio — home">
    <svg class="logo" viewBox="0 0 40 40" width="28" height="28" aria-hidden="true">
      <path d="M20 5.5 L35.5 33.5 H4.5 Z" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round"></path>
      <path d="M20 33.5 V19" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"></path>
    </svg>
    <span>DRYAS</span>
  </a>
  <nav class="nav" aria-label="Site">
    <a class="l" href="/#ch-1">How we build</a>
    <a class="l" href="/#services">Services</a>
    <a class="btn go" href="/contact/" aria-current={active === 'contact' ? 'page' : undefined}>Start a project</a>
  </nav>
</header>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px var(--gutter);
    background: var(--header-ground);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--hairline);
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .logo {
    color: var(--accent);
    filter: drop-shadow(0 0 6px var(--logo-glow));
  }

  .wordmark span {
    font: 800 19px/1 var(--font-display);
    font-stretch: 125%;
    letter-spacing: 0.08em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .l {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .l:hover {
    color: var(--fg);
  }

  @media (max-width: 860px) {
    .top {
      padding-block: 16px;
    }
    .l {
      display: none;
    }
  }
</style>
