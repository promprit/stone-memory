---
/**
 * The site's only piece of client JavaScript.
 *
 * Posts same-origin to /api/subscribe (a Pages Function in this repo, see
 * design doc §5). `stacked` is the sidebar form on the home page; `inline`
 * is a one-line variant for wider slots.
 *
 * No third-party script. The provider credential lives in the Function, so
 * nothing about the list provider is visible to a browser.
 */
interface Props {
  list: 'updates';
  label: string;
  /** Submit button content — an arrow in the sidebar, a word in the footer. */
  cta: string;
  layout?: 'stacked' | 'inline';
}

const { list, label, cta, layout = 'stacked' } = Astro.props;
const id = `signup-${list}`;
---

<form
  class:list={['signup', layout]}
  action="/api/subscribe"
  method="post"
  data-signup
  data-list={list}
  novalidate
>
  {/* `list` travels in the body so the no-JS form post reaches the same
      handler as the fetch. */}
  <input type="hidden" name="list" value={list} />
  <label class="label" for={id}>{label}</label>

  <div class="row">
    <input
      id={id}
      class="input"
      type="email"
      name="email"
      inputmode="email"
      autocomplete="email"
      placeholder="you@email.com"
      required
      aria-describedby={`${id}-status`}
    />
    {/* Honeypot: a real person never fills this, a naive bot always does.
        Hidden from assistive tech and from tab order, not just from sight. */}
    <div class="hp" aria-hidden="true">
      <label for={`${id}-company`}>Company</label>
      <input id={`${id}-company`} name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <button class="submit" type="submit">{cta}</button>
  </div>

  <p class="status" id={`${id}-status`} role="status" aria-live="polite"></p>
</form>

<style>
  .signup {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .label {
    font: 400 11px var(--font-mono);
    letter-spacing: 0.18em;
    color: var(--slate-grey);
    text-transform: uppercase;
  }

  .row {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .input {
    flex: 1;
    min-width: 0;
    font: 400 12px var(--font-mono);
    color: var(--moss-pale);
    background: var(--district-green);
    border: 1px solid var(--edge);
    border-radius: var(--radius);
    padding: 10px 14px;
  }
  .input::placeholder {
    color: var(--slate-grey);
  }
  .input:focus {
    border-color: var(--edge-hover);
  }

  /* Accent button — Earth Brown fill, Paper text. Accent only, per the
     brand rules: this is one of the two places it is allowed as a ground. */
  .submit {
    flex: none;
    font: 500 12px var(--font-mono);
    letter-spacing: 0.1em;
    background: var(--earth-brown);
    color: var(--paper);
    border: 0;
    border-radius: var(--radius);
    padding: 10px 16px;
    cursor: pointer;
    transition: opacity var(--t);
  }
  .submit:hover {
    opacity: 0.9;
  }
  .submit[disabled] {
    opacity: 0.55;
    cursor: default;
  }

  /* The inline variant sits on one line with a wider field. */
  .inline {
    flex-direction: row;
    align-items: center;
    gap: 10px;
  }
  .inline .label {
    letter-spacing: 0.14em;
    white-space: nowrap;
  }
  .inline .input {
    min-width: 200px;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .status {
    font: 400 11px var(--font-mono);
    letter-spacing: 0.12em;
    color: var(--slate-grey);
    min-height: 1em;
  }
  .status[data-state='error'] {
    color: var(--moss-pale);
  }

  /* Success swaps the form for a mono confirmation line, per the handoff. */
  .signup[data-done] .row,
  .signup[data-done] .label {
    display: none;
  }
  .signup[data-done] .status {
    color: var(--paper);
  }

  @media (max-width: 900px) {
    .inline {
      flex-wrap: wrap;
    }
    .input,
    .submit {
      /* >=44px hit target on touch. */
      padding-block: 14px;
    }
  }
</style>

<script>
  // Progressive enhancement: with JS off the form still posts natively to
  // /api/subscribe, which returns a plain response. With JS on it stays on
  // the page and swaps in the confirmation line.
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  document.querySelectorAll<HTMLFormElement>('form[data-signup]').forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('input[name="email"]')!;
    const honeypot = form.querySelector<HTMLInputElement>('input[name="company"]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = form.querySelector<HTMLParagraphElement>('.status')!;

    const say = (message: string, state?: 'error') => {
      status.textContent = message;
      if (state) status.dataset.state = state;
      else delete status.dataset.state;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (form.dataset.busy) return;

      const email = input.value.trim();
      if (!EMAIL.test(email)) {
        say('THAT DOES NOT LOOK LIKE AN EMAIL ADDRESS.', 'error');
        input.focus();
        return;
      }

      form.dataset.busy = 'true';
      button.disabled = true;
      say('SENDING…');

      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            email,
            list: form.dataset.list,
            company: honeypot.value,
          }),
        });

        if (response.ok) {
          form.dataset.done = 'true';
          say("YOU'RE ON THE LIST. CHECK YOUR INBOX TO CONFIRM.");
          return;
        }

        // 501 is the defined unconfigured state, not a crash — the Function
        // says so when no provider credential is bound. Everything else is a
        // genuine failure.
        say(
          response.status === 501
            ? 'SIGNUP IS NOT WIRED UP YET. TRY AGAIN SOON.'
            : 'THAT DID NOT GO THROUGH. TRY AGAIN.',
          'error',
        );
      } catch {
        say('NETWORK ERROR. TRY AGAIN.', 'error');
      } finally {
        delete form.dataset.busy;
        button.disabled = false;
      }
    });
  });
</script>
