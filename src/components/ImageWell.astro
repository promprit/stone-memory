---
/**
 * A placeholder image well: Shade ground, hairline border, mono caption.
 *
 * Every image on the site is one of these until the studio supplies real
 * assets — key art, screenshots, the portrait. The handoff says so
 * explicitly, and the design canvas draws them as dashed drop zones.
 *
 * When a real image arrives, the well renders it instead and nothing about the
 * surrounding layout changes. Pass `image` — a stem like `studio/portrait` —
 * and the file is resolved from `public/images/` at build time, whatever
 * extension it landed with. Absent, the placeholder caption shows. That is what
 * lets the studio owner upload a photo through the GitHub web UI with no code
 * change; see public/images/README.md.
 */
import { findImage } from '../lib/images';

interface Props {
  caption: string;
  height?: string;
  /** Stem under public/images, e.g. `studio/portrait`. Extension resolved. */
  image?: string;
  /** Explicit src, for an image that is not in public/images. */
  src?: string;
  alt?: string;
  /** Wells inside a Shade sidebar need the darker ground to invert. */
  onShade?: boolean;
  class?: string;
}

const {
  caption,
  height,
  image,
  src,
  alt,
  onShade = false,
  class: className,
} = Astro.props;

const resolved = src ?? (image ? findImage(image) : null);
---

<div
  class:list={['well', { 'on-shade': onShade, filled: !!resolved }, className]}
  style={height ? `height:${height}` : undefined}
>
  {
    resolved ? (
      <img src={resolved} alt={alt ?? caption} loading="lazy" decoding="async" />
    ) : (
      <span class="caption">{caption}</span>
    )
  }
</div>

<style>
  .well {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    text-align: center;
    background: var(--shade);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
  }

  /* Inside the Shade sidebar, invert the ground so the well still reads. */
  .on-shade {
    background: var(--district-green);
  }

  .caption {
    font: 400 11px/1.5 var(--font-mono);
    letter-spacing: 0.12em;
    color: var(--slate-grey);
    text-transform: uppercase;
  }

  .filled {
    padding: 0;
  }
  .well img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
